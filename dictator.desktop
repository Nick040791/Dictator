[Desktop Entry]
Version=1.0
Type=Application
Name=Dictator
GenericName=Push-to-Talk Dictation
Comment=Start/stop the Dictator speech-to-text service
# @PROJECT_DIR@ is replaced with the real install path by install.sh
Exec=@PROJECT_DIR@/scripts/toggle.sh
Icon=audio-input-microphone
Terminal=false
Categories=Utility;
StartupNotify=false
Keywords=dictation;speech;stt;voice;
Actions=Start;Stop;Restart;

[Desktop Action Start]
Name=Start
Exec=@PROJECT_DIR@/scripts/start.sh

[Desktop Action Stop]
Name=Stop
Exec=@PROJECT_DIR@/scripts/stop.sh

[Desktop Action Restart]
Name=Restart
Exec=@PROJECT_DIR@/scripts/restart.sh
